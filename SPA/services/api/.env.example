FLOWACCOUNT_DOCUMENT_ALLOWED_HOSTS=flowaccount.com,*.flowaccount.com
CASH_DEPOSIT_ENABLED=false
# Set true in Production only after written Beam/UOB merchant self-funding approval.
CASH_DEPOSIT_PROVIDER_CONTRACT_CONFIRMED=false
CASH_EVIDENCE_BUCKET=the49-487609-spa-cash-evidence-test
